<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="563.0" prefWidth="987.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.papeleria_campus.controller.ProductoController">
   <children>
      <Label layoutX="46.0" layoutY="28.0" text="Gestión de productos">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Separator layoutX="14.0" layoutY="77.0" prefHeight="10.0" prefWidth="959.0" />
      <GridPane layoutX="25.0" layoutY="101.0" prefHeight="171.0" prefWidth="426.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="222.0" minWidth="10.0" prefWidth="60.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="439.0" minWidth="10.0" prefWidth="366.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Código:" />
            <TextField fx:id="txtCodigo" promptText="Ingrese el código" GridPane.columnIndex="1" />
            <Label text="Nombre:" GridPane.rowIndex="1" />
            <TextField fx:id="txtNombre" promptText="Ingrese el nombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Categoría:" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbCategoria" prefHeight="25.0" prefWidth="230.0" promptText="Seleccione la categoría" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Precio:" GridPane.rowIndex="3" />
            <TextField fx:id="txtPrecio" promptText="ingrese el precio" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Stock:" GridPane.rowIndex="4" />
            <TextField fx:id="txtStock" promptText="Ingrese el stock" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
      <HBox layoutX="123.0" layoutY="276.0" prefHeight="30.0" prefWidth="333.0" spacing="10.0">
         <children>
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProducto" text="ELIMINAR">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarProducto" text="ACTUALIZAR">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarProducto" text="GUARDAR">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#limpiarFormulario" text="NUEVO">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
         </children>
      </HBox>
      <Separator layoutX="470.0" layoutY="81.0" orientation="VERTICAL" prefHeight="465.0" prefWidth="14.0" />
      <TableView fx:id="tblProductos" layoutX="493.0" layoutY="122.0" prefHeight="389.0" prefWidth="477.0">
        <columns>
          <TableColumn fx:id="colID" prefWidth="53.0" text="ID" />
          <TableColumn fx:id="colCodigo" prefWidth="69.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="138.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="101.0" text="Categoría" />
            <TableColumn fx:id="colPrecio" prefWidth="63.0" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="52.0" text="Stock" />
        </columns>
      </TableView>
      <Separator layoutX="-1.0" layoutY="316.0" prefHeight="17.0" prefWidth="477.0" />
      <Label layoutX="46.0" layoutY="343.0" text="Búsqueda y Filtros">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <GridPane layoutX="25.0" layoutY="383.0" prefHeight="70.0" prefWidth="426.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="222.0" minWidth="10.0" prefWidth="104.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="439.0" minWidth="10.0" prefWidth="322.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <Label text="Código o nombre:" />
            <TextField fx:id="txtCodigoNombre" promptText="Ingrese el código o nombre" GridPane.columnIndex="1" />
            <Label text="Categoría:" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbCategoriaBusqueda" prefHeight="25.0" prefWidth="230.0" promptText="Seleccione la categoría" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <CheckBox fx:id="chkSoloExistencias" layoutX="25.0" layoutY="461.0" mnemonicParsing="false" text="Solo en existencias" />
      <HBox layoutX="167.0" layoutY="487.0" prefHeight="30.0" prefWidth="284.0" spacing="10.0">
         <children>
            <Button fx:id="btnLimpiarFiltros" mnemonicParsing="false" onAction="#limpiarFiltros" text="LIMPIAR FILTROS">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnRecargar" mnemonicParsing="false" onAction="#recargarBusqueda" text="RECARGAR">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProducto" text="BUSCAR">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
